{
  "$schema": "./SetupAndRunSchema.json",
  "skillsRoot": "~/.skillz",
  "transport": "http",
  "host": "127.0.0.1",
  "port": 8000,
  "path": "/mcp",
  "corsOrigins": [
    "http://127.0.0.1:8282"
  ],
  "corsAllowCredentials": false,
  "python": {
    "uvSync": true,
    "frozen": true
  },
  "logging": {
    "verbose": false,
    "log": false,
    "logPath": ".skillz/skillz.log"
  }
}
